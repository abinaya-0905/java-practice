import java.util.*;
public class Main 
{
    public static void main(String[]args)
    {
        String  s="";
        int[] a=new int[5];
        Random r=new Random();
        int i=0,d;
        String x;
        while(i<5)
        {
            d=r.nextInt(10)+1;
            x=Integer.toString(d);
            if ((s.contains(x))==false)
            {
                a[i]=d;
                i++;
                s=s+x;
            }
        }
        System.out.println(Arrays.toString(a));
    }
}
