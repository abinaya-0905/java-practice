public class Main 
{
    public static int abi(int a)
    {
        int s=0;
        while(a>0)
        {
            s=s+(a%10);
            a=a/10;
        }
        return s;
    }
    
    public static boolean prime(int b)
    {
        if(b==1)
        return false;
        for(int j=2;j<b;j++)
        {
            if(b%j==0) 
            return false;
        }
        return true;
    }
    
    public static void main(String[]args)
    {
        int s;
        for(int i=100;i<1000;i++)
        {
            s=abi(i);
            if(prime(i) && prime(s))
            System.out.print(i+" ");
        }
    }
}
